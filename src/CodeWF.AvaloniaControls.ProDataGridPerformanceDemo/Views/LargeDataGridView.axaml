<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="CodeWF.AvaloniaControls.ProDataGridPerformanceDemo.Views.LargeDataGridView">
    <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <Border Padding="10,8"
                Background="#F8FAFC"
                BorderBrush="#E4E9F2"
                BorderThickness="1"
                CornerRadius="8">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="14" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitleBlock" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="SummaryBlock" Grid.Column="1" Foreground="#334155" FontWeight="SemiBold" />
                <TextBlock x:Name="HeaderDescriptionBlock"
                           Grid.Column="2"
                           Foreground="#5B6472"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E4E9F2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0">
            <DataGrid x:Name="ProcessDataGrid" />
        </Border>
    </Grid>
</UserControl>
