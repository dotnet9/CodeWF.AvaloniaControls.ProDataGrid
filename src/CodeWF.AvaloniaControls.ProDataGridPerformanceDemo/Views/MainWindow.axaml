<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodeWF.AvaloniaControls.ProDataGridPerformanceDemo.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:CodeWF.AvaloniaControls.ProDataGridPerformanceDemo.Views"
        x:Class="CodeWF.AvaloniaControls.ProDataGridPerformanceDemo.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1380"
        Height="900"
        Background="#F4F7FB"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        Icon="/Assets/avalonia-logo.ico"
        Title="ProDataGrid 性能回归示例"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        d:DesignWidth="1380"
        d:DesignHeight="900">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.Panel">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4E9F2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="TextBlock.Caption">
            <Setter Property="Foreground" Value="#5B6472" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinWidth" Value="136" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <Grid Margin="18" RowDefinitions="Auto,*" RowSpacing="12">
        <Border Classes="Panel"
                Padding="16,12"
                Background="#0F172A">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="ProDataGrid 性能示例" />
                    <TextBlock Classes="Caption"
                               Foreground="#CBD5E1"
                               Text="演示大数据表格在基础交互、页签切换和文档切换中的用法与效果。" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Border Padding="10,5" Background="#1D4ED855" CornerRadius="999">
                        <TextBlock Foreground="White" FontWeight="SemiBold" Text="12,000 行" />
                    </Border>
                    <Border Padding="10,5" Background="#0F766E55" CornerRadius="999">
                        <TextBlock Foreground="White" FontWeight="SemiBold" Text="十万级页签" />
                    </Border>
                    <Border Padding="10,5" Background="#9A341255" CornerRadius="999">
                        <TextBlock Foreground="White" FontWeight="SemiBold" Text="文档切换" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="Panel" Padding="10">
            <TabControl>
                <TabItem Header="基础交互">
                    <views:DataGridDemo />
                </TabItem>
                <TabItem Header="十万行页签">
                    <views:LargeDataGridView HeaderTitle="十万行切换页签"
                                             HeaderDescription="120,000 行常驻数据，重点观察页签来回切换时是否依然顺畅。"
                                             RowCount="120000"
                                             Seed="23" />
                </TabItem>
                <TabItem Header="二十万行页签">
                    <views:LargeDataGridView HeaderTitle="二十万行切换页签"
                                             HeaderDescription="180,000 行更高压力场景，用来放大滚动和重绘上的潜在卡顿。"
                                             RowCount="180000"
                                             Seed="29" />
                </TabItem>
                <TabItem Header="文档工作区">
                    <views:DocumentWorkspaceView />
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
