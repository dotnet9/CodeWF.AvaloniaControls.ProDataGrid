<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>CodeWF.AvaloniaControls.ProDataGrid.Themes</Title>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <Description>Theme resource adjustments for CodeWF.AvaloniaControls.ProDataGrid DataGrid templates.</Description>
    <PackageId>CodeWF.AvaloniaControls.ProDataGrid.Themes</PackageId>
    <AssemblyName>CodeWF.AvaloniaControls.ProDataGrid.Themes</AssemblyName>
    <RootNamespace>CodeWF.AvaloniaControls.ProDataGrid.Themes</RootNamespace>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>avalonia ui prodatagrid themes codewf</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="ProDataGrid" />
  </ItemGroup>
</Project>