<Window
    x:Class="CodeWF.AvaloniaControls.ProDataGridDemo.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:CodeWF.AvaloniaControls.ProDataGridDemo.Views.Pages"
    xmlns:views="clr-namespace:CodeWF.AvaloniaControls.ProDataGridDemo.Views"
    xmlns:vm="clr-namespace:CodeWF.AvaloniaControls.ProDataGridDemo.ViewModels"
    x:CompileBindings="True"
    x:DataType="vm:MainWindowViewModel"
    Title="ProDataGrid 示例 - 三态排序、分组表头、动态列、百万行性能"
    Width="1420"
    Height="900"
    Background="#F4F7FB"
    FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
    WindowStartupLocation="CenterScreen"
    d:DesignHeight="900"
    d:DesignWidth="1420"
    Icon="/Assets/logo.ico"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBorderBrush">#DCE3EE</SolidColorBrush>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.Panel">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="TabControl.DemoTabs">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TabControl.DemoTabs TabItem">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinWidth" Value="168" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Window.ScrollBarsExpanded ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>
        <Style Selector="Window.ScrollBarsExpanded ScrollBar:vertical">
            <Setter Property="Width" Value="16" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Window.ScrollBarsExpanded ScrollBar:horizontal">
            <Setter Property="Height" Value="16" />
            <Setter Property="MinHeight" Value="16" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Window.Styles>

    <Grid Margin="12">
        <Border Classes="Panel" Padding="8">
            <Grid RowDefinitions="Auto,*" RowSpacing="6">
                <Border Padding="8,5"
                        Background="#F8FAFC"
                        BorderBrush="#E4E9F2"
                        BorderThickness="1"
                        CornerRadius="6">
                    <CheckBox Content="滚动条不收缩"
                              FontWeight="SemiBold"
                              IsChecked="{Binding KeepScrollBarsExpanded}" />
                </Border>

                <TabControl Grid.Row="1"
                            Classes="DemoTabs"
                            TabStripPlacement="Left">
                    <TabItem Header="三态排序">
                        <pages:SortingView Margin="8" DataContext="{Binding Sorting}" />
                    </TabItem>
                    <TabItem Header="分组表头">
                        <pages:CrossRowsAndColumnsView Margin="8" DataContext="{Binding GroupedHeaders}" />
                    </TabItem>
                    <TabItem Header="动态列">
                        <pages:DynamicColumnsView Margin="8" DataContext="{Binding DynamicColumns}" />
                    </TabItem>
                    <TabItem Header="百万行性能">
                        <views:LargeDataGridView Margin="8" DataContext="{Binding MillionRows}" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</Window>
