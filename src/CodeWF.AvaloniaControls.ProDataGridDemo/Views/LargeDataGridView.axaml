<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CodeWF.AvaloniaControls.ProDataGridDemo.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="vm:LargeDataGridViewModel"
             x:CompileBindings="True"
             x:Class="CodeWF.AvaloniaControls.ProDataGridDemo.Views.LargeDataGridView">
    <Border Background="White"
            BorderBrush="#E4E9F2"
            BorderThickness="1"
            CornerRadius="6"
            Padding="0">
        <DataGrid x:Name="ProcessDataGrid" />
    </Border>
</UserControl>
