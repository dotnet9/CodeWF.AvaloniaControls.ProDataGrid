<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CodeWF.AvaloniaControls.ProDataGridDemo.App"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:codewf="https://codewf.com"
             xmlns:local="clr-namespace:CodeWF.AvaloniaControls.ProDataGridDemo">
	<Application.Styles>
        <FluentTheme />
        <semi:SemiTheme Locale="zh-CN" />
        <codewf:CodeWFProDataGridTheme />
        <local:OwnerTheme />
    </Application.Styles>
</Application>
