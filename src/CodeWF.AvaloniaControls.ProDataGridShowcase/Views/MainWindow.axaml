<Window
    x:Class="CodeWF.AvaloniaControls.ProDataGridShowcase.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:CodeWF.AvaloniaControls.ProDataGridShowcase.Views.Pages"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:CodeWF.AvaloniaControls.ProDataGridShowcase.ViewModels"
    prism:ViewModelLocator.AutoWireViewModel="True"
    x:CompileBindings="True"
    x:DataType="vm:MainWindowViewModel"
    Title="ProDataGrid 开源展示馆"
    Width="1280"
    Height="860"
    Background="#F3F6FB"
    FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
    WindowStartupLocation="CenterScreen"
    d:DesignHeight="860"
    d:DesignWidth="1280"
    Icon="/Assets/logo.ico"
    mc:Ignorable="d">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBorderBrush">#DCE3EE</SolidColorBrush>
        <LinearGradientBrush x:Key="HeroBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B132B" Offset="0" />
            <GradientStop Color="#14532D" Offset="0.52" />
            <GradientStop Color="#0EA5E9" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.Panel">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="TextBlock.Caption">
            <Setter Property="Foreground" Value="#64748B" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <Grid Margin="18" RowDefinitions="Auto,*" RowSpacing="12">
        <Border Padding="16,12"
                CornerRadius="14"
                Background="{StaticResource HeroBackground}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Width="38" Height="38" CornerRadius="10" Background="#1E293B">
                    <Image Width="24"
                           Height="24"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           Source="/Assets/logo.png" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="ProDataGrid 功能示例" />
                    <TextBlock Foreground="#D7E8F6"
                               Text="演示三态排序、分组表头和动态列的用法与效果。" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Border Padding="10,5" Background="#064E3B55" CornerRadius="999">
                        <TextBlock Foreground="White" FontWeight="SemiBold" Text="三态排序" />
                    </Border>
                    <Border Padding="10,5" Background="#1D4ED855" CornerRadius="999">
                        <TextBlock Foreground="White" FontWeight="SemiBold" Text="分组表头" />
                    </Border>
                    <Border Padding="10,5" Background="#7C2D1255" CornerRadius="999">
                        <TextBlock Foreground="White" FontWeight="SemiBold" Text="动态列" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="Panel" Padding="10">
            <TabControl CornerRadius="8,8,0,0"
                        TabStripPlacement="Top">
                <TabControl.Styles>
                    <Style Selector="TabControl">
                        <Setter Property="Background" Value="#55FFFFFF" />
                    </Style>
                </TabControl.Styles>

                <TabItem Header="三态排序">
                    <pages:SortingView Margin="10" Padding="10" />
                </TabItem>
                <TabItem Header="分组表头">
                    <pages:CrossRowsAndColumnsView Margin="10" Padding="10" />
                </TabItem>
                <TabItem Header="动态列">
                    <pages:DynamicColumnsView Margin="10" Padding="10" />
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
